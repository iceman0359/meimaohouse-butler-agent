# ===== 模型厂商配置 =====
# 管家与子 Agent 共用模型工厂（packages/agent-sdk/src/model.ts）。
# 未配置时首次调用会抛 ModelNotConfiguredError，提示你配置。
# 注意：框架不强制安装任何厂商 SDK——用哪个厂商才需要装哪个依赖：
#   - openai / deepseek：DeepSeek 为 OpenAI 兼容接口，复用 openai 通道（需要 npm i openai）
#   - bedrock：默认随 @strands-agents/sdk 的 peer 依赖安装
#   - ollama：需要 npm i ollama-ai-provider + 本地运行 Ollama 服务

# 模型厂商：bedrock | openai | deepseek | meimaoapi | ollama（更多厂商后续在此扩展）
MODEL_PROVIDER=

# ---- meimaoapi（眉猫 API 聚合，OpenAI 兼容）----
# 需先安装: npm i openai
# MEIMAOAPI_API_KEY=sk-xxx   # 示例占位；真实 key 写入 .env（本文件会被 git 跟踪）
# MEIMAOAPI_BASE_URL=https://meimaoapi.top/v1
# MEIMAOAPI_MODEL_ID=qwen3.8-flash   # 实际可用模型名（qwen 与 3.8 之间无连字符）

# ---- DeepSeek（官方接口）----
# 需先安装: npm i openai
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_ID=deepseek-chat      # 或 deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- OpenAI ----
OPENAI_API_KEY=
# 可选：指定模型（默认用 SDK 默认值）
# OPENAI_MODEL_ID=

# ---- Amazon Bedrock ----
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ---- Ollama（本地免费）----
# OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_MODEL_ID=qwen2.5:7b

# ===== 数据库 =====
# SQLite 文件路径（缺省 ./data/butler.db；目录不存在自动创建；重启数据保留）
# BUTLER_DB_PATH=./data/butler.db
