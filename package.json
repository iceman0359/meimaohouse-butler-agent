{
  "name": "meimaohouse-butler-agent",
  "version": "0.1.0",
  "private": true,
  "description": "大庄园式管家 Agent 框架：一个总协调管家 + 平级领域子 Agent",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/agents/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "test:db": "npm test -w @meimaohouse/db",
    "demo": "npx tsx --env-file-if-exists=.env examples/butler-demo.ts",
    "demo:db": "npx tsx examples/db-demo.ts",
    "db:inspect": "npx tsx examples/db-inspect.ts",
    "web": "npm run build -w @meimaohouse/butler-web && node --env-file-if-exists=.env apps/butler-web/dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
